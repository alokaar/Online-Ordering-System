# Customer Service - Environment Variables (Example)
# Copy this to .env in the project root and fill in your values

# MongoDB Configuration
MONGODB_URI=mongodb+srv://aloka:Aloka180402@cluster1.h0mabke.mongodb.net/food_ordering
# For MongoDB Atlas, uncomment and fill these:
# MONGODB_USER=your_username
# MONGODB_PASSWORD=your_password
